{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "brand": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "default": "16:9",
      "type": "string",
      "enum": [
        "16:9",
        "9:16"
      ]
    },
    "beatSync": {
      "default": true,
      "type": "boolean"
    },
    "music": {
      "default": "auto",
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "boxes": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Name of the region as the dev gave it, e.g. \"Tarjeta Plan Propio\""
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Left edge as a fraction of the image width"
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Top edge as a fraction of the image height"
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "description": "Width as a fraction of the image width"
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "description": "Height as a fraction of the image height"
                },
                "source": {
                  "default": "given",
                  "description": "given: the dev provided it; measured: the producer measured it on the capture",
                  "type": "string",
                  "enum": [
                    "given",
                    "measured"
                  ]
                },
                "measuredBy": {
                  "description": "Who measured the box, only when source is measured",
                  "type": "string",
                  "minLength": 1
                },
                "measuredAt": {
                  "description": "ISO instant of the measurement, only when source is measured",
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "name",
                "x",
                "y",
                "w",
                "h"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "file",
          "caption"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "brand",
    "script"
  ],
  "additionalProperties": false
}
