{
  "name": "@video-maker/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup:agents": "node -e \"if(process.platform==='win32'){require('child_process').execSync('powershell -ExecutionPolicy Bypass -File sdd/scripts/setup-agents.ps1',{stdio:'inherit'})}else{require('child_process').execSync('bash sdd/scripts/setup-agents.sh',{stdio:'inherit'})}\"",
    "studio": "node scripts/start-studio.mjs",
    "studio:api": "node scripts/start-studio.mjs api",
    "studio:web": "node scripts/start-studio.mjs web",
    "studio:stop": "node scripts/stop-studio.mjs",
    "fetch:dev-voices": "node scripts/fetch-dev-voices.mjs",
    "desktop:dist": "node apps/desktop/scripts/build-desktop.mjs",
    "desktop:release": "node apps/desktop/scripts/release-desktop.mjs",
    "sdd:docs": "node sdd/docs/serve.mjs",
    "sdd:validate": "node sdd/scripts/validate-sdd.mjs",
    "sdd:rebuild-tasks-index": "node sdd/scripts/rebuild-tasks-index.mjs",
    "sdd:rebuild-catalog": "node sdd/scripts/rebuild-catalog.mjs",
    "web": "nx serve web",
    "build:web": "nx build web",
    "test:web": "nx test web",
    "lint:web": "nx lint web",
    "sdd:rtk": "node sdd/scripts/setup-rtk.mjs",
    "postinstall": "node -e \"const f='sdd/scripts/setup-rtk.mjs';if(require('fs').existsSync(f)){require('child_process').execFileSync(process.execPath,[f],{stdio:'inherit'})}\"",
    "sdd:gate": "node sdd/scripts/spec-gate.mjs",
    "motion-editor": "nx dev motion-editor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@remotion/bundler": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/player": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "@remotion/transitions": "4.0.522",
    "ai": "7.0.113",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "execa": "^10.0.1",
    "mp4-muxer": "^5.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "remotion": "4.0.522",
    "zod": "^4.5"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "eslint": "^9.8.0",
    "jsdom": "^27.1.0",
    "nx": "23.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "description": "Motor y plataforma local de edición y postproducción de video para redes sociales (Reels/TikTok 9:16 y YouTube 16:9): pipeline declarativo en TypeScript sobre FFmpeg + Whisper local y Remotion, que ensambla clips reales, fotos de apoyo, locución y música sin depender de APIs externas pagas."
}
