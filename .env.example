# Copy to .env and fill in the absolute paths for your machine: cp .env.example .env
#
# Consumers read this file three different ways -- do not assume one covers all:
#   - Nx tasks: loaded automatically into every `pnpm nx run ...` process.
#   - docker-compose: interpolates ${VAR} from this directory's .env.
#   - plain `node script.ts`: sees NOTHING. Use `set -a && source .env && set +a`.
#
# Absolute paths only: dotenv does not expand ~ or $HOME.

# --- Local media toolchain ------------------------------------------------
# Resolved by resolveBinaries() in libs/media-local. Precedence is env > PATH:
# a variable pointing at a non-existent path throws BinaryNotFoundError instead
# of falling back to PATH. Comment a line out to resolve it from PATH instead.
#
# Install: brew install ffmpeg whisper-cpp
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
WHISPER_CPP_PATH=/opt/homebrew/bin/whisper-cli

# The ggml model is NOT shipped by Homebrew and has no PATH fallback -- download
# it manually (~547 MB) and point this at the .bin:
#   curl -L -o ~/.cache/whisper-models/ggml-large-v3-turbo-q5_0.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin
# Verify it is 574041195 bytes -- a truncated file fails late, inside whisper-cli.
WHISPER_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin

# --- App ports ------------------------------------------------------------
# WEB_PORT: harness.config.json apps[].port -- apps/web/vite.config.ts falls back
# to this, then to PORT, then to 4200.
WEB_PORT=4200
VITE_BASE_PATH=/

# --- MinIO (S3-compatible) ------------------------------------------------
# Consumed by docker-compose.yml via ${MINIO_USER}/${MINIO_PASSWORD}, and later
# by apps/render-api (spec-005). Change these before exposing MinIO anywhere.
MINIO_USER=admin
MINIO_PASSWORD=admin123
MINIO_ENDPOINT=http://localhost:9000

# --- App ------------------------------------------------------------------
NODE_ENV=development
JWT_SECRET=change-me-in-production
