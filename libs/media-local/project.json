{
  "name": "media-local",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/media-local/src",
  "projectType": "library",
  "tags": ["scope:engine", "type:util"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage --passWithNoTests",
        "cwd": "libs/media-local"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/out-tsc/libs/media-local"],
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "libs/media-local"
      }
    },
    "smoke-audio": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/media-local",
        "parallel": false,
        "commands": [
          "tsc -p tsconfig.smoke.json --noEmit",
          "node -r ./smoke/smoke-register.cjs ./smoke/smoke-audio.ts"
        ],
        "env": { "SWC_NODE_PROJECT": "./tsconfig.smoke.json" }
      }
    }
  }
}
