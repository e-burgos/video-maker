{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-maker.local/schemas/media-asset.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "audio"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rotation": {
      "type": "number",
      "enum": [
        0,
        90,
        180,
        270
      ]
    },
    "hasAudio": {
      "type": "boolean"
    },
    "audio": {
      "type": "object",
      "properties": {
        "sampleRate": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "codec": {
          "type": "string"
        },
        "integratedLufs": {
          "type": "number"
        }
      },
      "required": [
        "sampleRate",
        "channels"
      ],
      "additionalProperties": false
    },
    "videoCodec": {
      "type": "string"
    },
    "probedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "kind",
    "path",
    "durationMs",
    "probedAt"
  ],
  "additionalProperties": false
}
