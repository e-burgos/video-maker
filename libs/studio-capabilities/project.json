{
  "name": "studio-capabilities",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/studio-capabilities/src",
  "projectType": "library",
  "tags": ["scope:engine", "type:capabilities"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests",
        "cwd": "libs/studio-capabilities"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/out-tsc/libs/studio-capabilities"],
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "libs/studio-capabilities"
      }
    }
  }
}
