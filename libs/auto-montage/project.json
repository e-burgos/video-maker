{
  "name": "auto-montage",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auto-montage/src",
  "projectType": "library",
  "tags": ["scope:engine", "type:feature"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage --passWithNoTests",
        "cwd": "libs/auto-montage"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/out-tsc/libs/auto-montage"],
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "libs/auto-montage"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register ./src/smoke.ts",
        "cwd": "libs/auto-montage",
        "env": {
          "SWC_NODE_PROJECT": "../../tsconfig.base.json"
        }
      }
    }
  }
}
