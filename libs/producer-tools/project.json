{
  "name": "producer-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/producer-tools/src",
  "projectType": "library",
  "tags": ["scope:engine", "type:feature"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage --passWithNoTests",
        "cwd": "libs/producer-tools"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/out-tsc/libs/producer-tools"],
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "libs/producer-tools"
      }
    },
    "mcp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ./libs/producer-tools/src/mcp/mcp-register.cjs libs/producer-tools/src/mcp/main.ts",
        "env": {
          "SWC_NODE_PROJECT": "tsconfig.base.json"
        }
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/producer-tools/mcp"],
      "options": {
        "command": "node scripts/esbuild-node-bundle.mjs libs/producer-tools/src/mcp/main.ts dist/libs/producer-tools/mcp/main.js"
      }
    }
  }
}
