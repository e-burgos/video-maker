{
  "name": "docs-site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs-site/src",
  "projectType": "application",
  "tags": ["scope:docs", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/docs-site"],
      "options": {
        "command": "node scripts/build.mjs",
        "cwd": "apps/docs-site"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/docs-site"
      }
    }
  }
}
