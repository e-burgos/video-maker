{
  "name": "motion-studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/motion-studio/src",
  "projectType": "application",
  "tags": ["scope:engine", "type:tool"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage --passWithNoTests",
        "cwd": "tools/motion-studio"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/out-tsc/tools/motion-studio"],
      "options": {
        "command": "tsc -p tsconfig.lib.json",
        "cwd": "tools/motion-studio"
      }
    },
    "cli": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r ./tools/motion-studio/src/cli-register.cjs tools/motion-studio/src/main.ts",
        "env": { "SWC_NODE_PROJECT": "tsconfig.base.json" }
      }
    }
  }
}
