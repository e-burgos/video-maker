{
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ]
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "SDD rtk rewrite",
            "command": "node sdd/scripts/rtk-hook.mjs gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "tucu-ui": {
      "command": "npx",
      "args": [
        "-y",
        "@e-burgos/tucu-ui-mcp@0.16.0"
      ]
    }
  }
}
